<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 0) WEB PRINCIPAL: forzar https y sin www
  RewriteCond %{HTTP_HOST} ^(www\.)?de10\.app$ [NC]
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.de10\.app$ [NC]
  RewriteRule ^(.*)$ https://de10.app/$1 [R=301,L]

  # 1) SUBDOMINIOS: bots sociales -> share de producto
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|WhatsApp|Twitterbot|LinkedInBot|Pinterest|Slackbot|Discordbot) [NC]
  RewriteCond %{HTTP_HOST} ^([^.]+)\.de10\.app$ [NC]
  RewriteCond %{HTTP_HOST} !^(www|de10)\.de10\.app$ [NC]
  RewriteRule ^producto/([0-9]+)(?:/([^/]+))?$ https://de10.app/backend/tienda/%1/producto/$1/$2/_share?url=https://%1.de10.app%{REQUEST_URI} [R=302,L,QSA]

  # 2) SUBDOMINIOS: bots sociales -> share de categoría
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|WhatsApp|Twitterbot|LinkedInBot|Pinterest|Slackbot|Discordbot) [NC]
  RewriteCond %{HTTP_HOST} ^([^.]+)\.de10\.app$ [NC]
  RewriteCond %{HTTP_HOST} !^(www|de10)\.de10\.app$ [NC]
  RewriteRule ^categoria/([0-9]+)(?:/([^/]+))?$ https://de10.app/backend/tienda/%1/categoria/$1/$2/_share?url=https://%1.de10.app%{REQUEST_URI} [R=302,L,QSA]

  # 3) SUBDOMINIOS: bots sociales -> share de home / resto de páginas
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|WhatsApp|Twitterbot|LinkedInBot|Pinterest|Slackbot|Discordbot) [NC]
  RewriteCond %{HTTP_HOST} ^([^.]+)\.de10\.app$ [NC]
  RewriteCond %{HTTP_HOST} !^(www|de10)\.de10\.app$ [NC]
  RewriteRule ^.*$ https://de10.app/backend/tienda/%1/_share?url=https://%1.de10.app%{REQUEST_URI} [R=302,L,QSA]

  # 4) Sitemap en raíz -> backend
  RewriteRule ^sitemap\.xml$ /backend/sitemap.xml [L]

  # 5) Si el archivo o directorio existe, servirlo directo
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 6) SPA fallback
  RewriteRule ^ index.html [L]
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|svg|webp|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>